{
    "name": "proof/legacy-php",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": ">=5.6 <7.0",
        "psr/log": "1.1.4"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "psr/log",
                "version": "1.1.4",
                "type": "library",
                "require": {
                    "php": ">=5.3.0"
                },
                "autoload": {
                    "psr-4": {
                        "Psr\\Log\\": "Psr/Log/"
                    }
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/php-fig/log/zipball/d49695b909c3b7628b6289db5479a1c204601f11",
                    "reference": "d49695b909c3b7628b6289db5479a1c204601f11",
                    "shasum": ""
                }
            }
        },
        {
            "packagist.org": false
        }
    ],
    "bin": [
        "bin/legacy-php"
    ],
    "scripts": {
        "post-install-cmd": "@php -r 'file_put_contents(\"built.txt\", PHP_VERSION);'",
        "test": "@php bin/legacy-php"
    }
}
